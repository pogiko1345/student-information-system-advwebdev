PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/student_information_system
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
# For a Vercel backend project, use a MongoDB Atlas URI and set CLIENT_ORIGIN
# to the exact HTTPS origin of the deployed frontend (no trailing slash).
